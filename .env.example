# Copy values as needed, then export them before starting the application.
DATABASE_URL=postgresql://slidebi_app@localhost:5432/slidebi
SLIDEBI_HOST=127.0.0.1
SLIDEBI_PORT=4310
SLIDEBI_JSON_LIMIT=10mb
SLIDEBI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4310,http://127.0.0.1:4310
# SLIDEBI_STORAGE_DIR=/absolute/path/to/slidebi-files
# SLIDEBI_BI_BASE_URL=https://bi-studio.example.com

# Database bootstrap. The URL must identify an administrative PostgreSQL user.
SLIDEBI_ADMIN_URL=postgresql://localhost:5432/postgres
SLIDEBI_DB_NAME=slidebi
SLIDEBI_TEST_DATABASE_URL=postgresql://slidebi_app@localhost:5432/slidebi_test

# Frontend and browser tests.
SLIDEBI_WEB_HOST=127.0.0.1
SLIDEBI_WEB_PORT=5173
SLIDEBI_API_PROXY_TARGET=http://127.0.0.1:4310
SLIDEBI_E2E_BASE_URL=http://127.0.0.1:5173
SLIDEBI_E2E_USERNAME=marx
SLIDEBI_E2E_PASSWORD=admin
# SLIDEBI_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
