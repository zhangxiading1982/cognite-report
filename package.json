{
  "name": "slidebi",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "backend/packages/presentation",
    "frontend"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently -k 'npm run dev -w @slidebi/backend' 'npm run dev -w @slidebi/frontend'",
    "dev:backend": "npm run dev -w @slidebi/backend",
    "dev:frontend": "npm run dev -w @slidebi/frontend",
    "build": "npm run build -w @slidebi/frontend",
    "env:check": "bash scripts/check-environment.sh",
    "setup": "bash scripts/bootstrap-development.sh",
    "db:setup": "tsx backend/src/setup-db.ts",
    "db:init": "bash scripts/init-database.sh",
    "db:seed": "npm run db:seed -w @slidebi/backend",
    "test:e2e": "playwright test",
    "db:test:setup": "SLIDEBI_DB_NAME=slidebi_test tsx backend/src/setup-db.ts",
    "data:review15:reset": "npm run data:review15:reset -w @slidebi/backend",
    "docs:check": "node scripts/check-doc-links.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "release:check": "bash scripts/check-release.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
